+        alertname: JavaDemoHeapUsageHigh
+        exp_alerts:
+          - exp_labels: {job: java-demo, instance: i-1, severity: warning, team: lab}
+            exp_annotations:
+              summary: "Heap à 80% sur i-1"
+              description: "La heap utilisée dépasse 70 % du max (-Xmx) depuis 2 min : fuite mémoire probable ou heap trop petite."
+
+  # Heap à 95 % : warning et critical en même temps
   - interval: 1m
     input_series:
       - series: 'jvm_memory_used_bytes{job="java-demo", instance="i-1", jvm_memory_type="heap", jvm_memory_pool_name="G1 Old Gen"}'
@@ -138,13 +157,17 @@ tests:
       - series: 'jvm_memory_limit_bytes{job="java-demo", instance="i-1", jvm_memory_type="heap", jvm_memory_pool_name="G1 Old Gen"}'
         values: '100x10'
     alert_rule_test:
-      - eval_time: 8m
+      - eval_time: 5m
         alertname: JavaDemoHeapUsageHigh
         exp_alerts:
+          - exp_labels: {job: java-demo, instance: i-1, severity: critical, team: lab}
+            exp_annotations:
+              summary: "Heap à 95% sur i-1"
+              description: "La heap utilisée dépasse 90 % du max (-Xmx) depuis 2 min : OutOfMemoryError imminente."
           - exp_labels: {job: java-demo, instance: i-1, severity: warning, team: lab}
             exp_annotations:
               summary: "Heap à 95% sur i-1"
-              description: "La heap utilisée dépasse 90 % du max (-Xmx) depuis 5 min : risque d'OutOfMemoryError."
+              description: "La heap utilisée dépasse 70 % du max (-Xmx) depuis 2 min : fuite mémoire probable ou heap trop petite."
 
   # 20 % du temps en GC
