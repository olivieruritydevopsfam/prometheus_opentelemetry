diff --git a/prometheus/rules/java-demo.rules.yml b/prometheus/rules/java-demo.rules.yml
index aa9bf70..296ecb7 100644
--- a/prometheus/rules/java-demo.rules.yml
+++ b/prometheus/rules/java-demo.rules.yml
@@ -122,13 +122,23 @@ groups:
       # --- JVM -----------------------------------------------------------------
       - alert: JavaDemoHeapUsageHigh
         expr: job:jvm_memory_heap_used:ratio > 0.9
-        for: 5m
+        for: 2m
+        labels:
+          severity: critical
+          team: lab
+        annotations:
+          summary: "Heap à {{ $value | humanizePercentage }} sur {{ $labels.instance }}"
+          description: "La heap utilisée dépasse 90 % du max (-Xmx) depuis 2 min : OutOfMemoryError imminente."
+
+      - alert: JavaDemoHeapUsageHigh
+        expr: job:jvm_memory_heap_used:ratio > 0.7
+        for: 2m
         labels:
           severity: warning
           team: lab
         annotations:
           summary: "Heap à {{ $value | humanizePercentage }} sur {{ $labels.instance }}"
-          description: "La heap utilisée dépasse 90 % du max (-Xmx) depuis 5 min : risque d'OutOfMemoryError."
+          description: "La heap utilisée dépasse 70 % du max (-Xmx) depuis 2 min : fuite mémoire probable ou heap trop petite."
 
       - alert: JavaDemoGCTimeHigh
         expr: sum by (job, instance) (rate(jvm_gc_duration_seconds_sum[5m])) > 0.1
diff --git a/prometheus/tests/java-demo.rules.test.yml b/prometheus/tests/java-demo.rules.test.yml
