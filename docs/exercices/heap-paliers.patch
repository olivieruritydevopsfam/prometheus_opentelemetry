-  # Heap à 95 % du max
+  # Heap à 80 % : warning seulement (palier 70 %)
+  - interval: 1m
+    input_series:
+      - series: 'jvm_memory_used_bytes{job="java-demo", instance="i-1", jvm_memory_type="heap", jvm_memory_pool_name="G1 Old Gen"}'
